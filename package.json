{
  "name": "ssh-manager",
  "version": "0.43.0",
  "description": "A desktop SSH manager built around running and resuming Claude Code sessions, with embedded terminals.",
  "author": "Reza",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:relay && electron-vite dev",
    "build": "npm run build:relay && electron-vite build",
    "build:relay": "vite build -c vite.relay.config.ts",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "npm run build:relay && electron-vite build && electron-builder --win",
    "dist:mac": "npm run build:relay && electron-vite build && electron-builder --mac",
    "dist:linux": "npm run build:relay && electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
