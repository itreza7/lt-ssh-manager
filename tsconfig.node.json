{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "./out"
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/relay/**/*", "electron.vite.config.ts", "vite.relay.config.ts"]
}
